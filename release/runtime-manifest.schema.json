{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/assetforgeai-tech/CashPilot/release/runtime-manifest.schema.json",
  "title": "CashPilot runtime distribution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "rollback_release", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "rollback_release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "hmac-sha256"},
        "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "provider", "architecture", "source", "reference", "path", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "architecture": {"enum": ["linux/amd64", "linux/arm64"]},
          "source": {"enum": ["github-release", "ghcr"]},
          "kind": {"enum": ["file", "container-image"]},
          "reference": {"type": "string", "pattern": "^ghcr\\.io/.+@sha256:[a-f0-9]{64}$"},
          "asset_url": {"type": "string", "pattern": "^https://github\\.com/.+/releases/download/.+$"},
          "path": {"type": "string", "pattern": "^[^/\\\\]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
