# Example only. Credentials stay in the secret store referenced by inventory.
Host cashpilot-worker-example
    HostName 203.0.113.10
    User cashpilot
    IdentityFile ~/.config/cashpilot/worker-example_ed25519
    IdentitiesOnly yes
    BatchMode yes

# Wrapper usage (read-only preflight before SSH):
# pwsh -NoProfile -File tools/ssh-worker.ps1 -WorkerId <id> -ResourceGroup <rg> -VmName <vm> -KeyPath <inventory-secret-path>
